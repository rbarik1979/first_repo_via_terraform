resource "aws_instance" "example2" {
  ami           = "ami-0b6d9d3d33ba97d99"
  instance_type = "t3.micro"

  tags = {
    Name = "test-instance1"
  }
  provisioner "local-exec" {

    command = <<EOT
        echo "Private IP: ${self.private_ip}" >> ${self.tags.Name}.txt
    EOT

  }
}

/*
resource "null_resource" "always_run" {
  triggers = {
    timestamp = timestamp()
  }

  provisioner "local-exec" {
    command = "echo Hello >> ${aws_instance.example.tags.Name}.txt && echo 2nd test line to the same file >> ${aws_instance.example.tags.Name}.txt && echo ******** >> ${aws_instance.example.tags.Name}.txt "

  }
}

*/

resource "null_resource" "always_run" {
  triggers = {
    timestamp = timestamp()
  }

  provisioner "local-exec" {
    command = "echo ===== Run Started ===== >> ${aws_instance.example.tags.Name}.txt && echo Hello >> ${aws_instance.example.tags.Name}.txt && echo 4th test line to the same file >> ${aws_instance.example.tags.Name}.txt && echo ======================= >> ${aws_instance.example.tags.Name}.txt"
  }
}

